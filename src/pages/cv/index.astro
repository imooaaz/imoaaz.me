---
import Base from '../../layouts/Base.astro';
import { experience, education, volunteering } from '../../data/experience';
import { certs } from '../../data/certs';
import { services, domains, languages } from '../../data/services';
import { projects } from '../../data/projects';
import { EMAIL, SITE_URL, SOCIALS } from '../../data/site';

const PDF = '/assets/cv/Moaaz-Afifi-CV.pdf';
const host = SITE_URL.replace(/^https?:\/\//, '');
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base
  page="cv"
  bodyClass="blog cv-page"
  title="CV | Moaaz Afifi"
  description="CV of Moaaz Afifi, Cyber & Product Security Engineer at Raqyan: experience, skills, certifications, and projects."
  ogType="website"
  ogTitle="CV | Moaaz Afifi"
  ogDescription="Cyber & Product Security Engineer at Raqyan. Read, print, or share my CV."
  path="/cv/"
>
  <section class="hero hero-page cv-hero">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="container">
      <p class="hero-kicker mono">Moaaz Afifi</p>
      <h1 class="hero-name">Curriculum Vitae</h1>
      <p class="hero-role">Read it here, print it, or save it as a PDF.</p>
      <div class="hero-actions cv-actions" data-cv={PDF}>
        <button class="btn btn-solid" id="cv-print" type="button"><svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><rect x="7" y="14" width="10" height="7" rx="1"/></svg>Print / Save as PDF</button>
        <a class="btn" id="cv-download" href={PDF} download="Moaaz-Afifi-CV.pdf" hidden><svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 19h16"/></svg>Download PDF</a>
        <button class="btn" id="cv-share" type="button"><svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg><span class="cv-share-label">Share</span></button>
        <button class="btn" id="cv-qr" type="button" aria-haspopup="dialog" aria-controls="qr-dialog"><svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20v.01M17 20h4v-3"/></svg>QR code</button>
      </div>
    </div>
  </section>

  <section class="section cv-section">
    <div class="container">
      <article class="resume">
        <header class="resume-head">
          <div>
            <p class="resume-name">Moaaz Afifi</p>
            <p class="resume-title">Cyber &amp; Product Security Engineer · Raqyan</p>
          </div>
          <ul class="resume-contact mono">
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li><a href="/">{host}</a></li>
            <li><a href={SOCIALS.linkedin} target="_blank" rel="noopener me">{short(SOCIALS.linkedin)}</a></li>
            <li><a href={SOCIALS.github} target="_blank" rel="noopener me">{short(SOCIALS.github)}</a></li>
          </ul>
        </header>

        <section class="resume-sec">
          <h2 class="resume-h mono">Profile</h2>
          <div class="resume-body">
            <p>Security engineer with a software development background. I work on both sides of a product: shipping it at Raqyan, and attacking it as a penetration tester and bug bounty researcher. My focus is product security, application security, and DevSecOps.</p>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Experience</h2>
          <div class="resume-body">
            {experience.map((e) => (
              <div class="resume-item">
                <div class="resume-item-head">
                  <h3 class="resume-role">{e.role}</h3>
                  <p class="resume-dates mono">{e.dates}</p>
                </div>
                <p class="resume-org">{e.org}{e.type && <> <span class="resume-type">· {e.type}</span></>}</p>
                <p class="resume-desc">{e.desc}</p>
                {e.points && (
                  <ul class="resume-points">
                    {e.points.map((p) => <li><strong>{p.label}:</strong> <Fragment set:html={p.text} /></li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Skills</h2>
          <div class="resume-body">
            <dl class="resume-skills">
              {services.map((s) => (
                <div>
                  <dt>{s.name}</dt>
                  <dd>{s.tags.join(' · ')}</dd>
                </div>
              ))}
            </dl>
            <p class="resume-domains"><strong>Domains:</strong> {domains.join(' · ')}</p>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Certifications</h2>
          <div class="resume-body">
            <ul class="resume-list">
              {certs.map((c) => <li><strong>{c.abbr}</strong> · {c.name} <span class="resume-type">({c.issuer})</span></li>)}
            </ul>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Projects &amp; research</h2>
          <div class="resume-body">
            <ul class="resume-list">
              {projects.map((p) => (
                <li>
                  <strong>{p.title}</strong> · {p.desc}
                  {p.links?.map((l) => <> <a href={l.href} target="_blank" rel="noopener">{short(l.href)}</a></>)}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Education</h2>
          <div class="resume-body">
            <p><strong>{education.title}</strong><br>{education.place}</p>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Volunteering</h2>
          <div class="resume-body">
            <ul class="resume-list">
              {volunteering.map((v) => <li>{v}</li>)}
            </ul>
          </div>
        </section>

        <section class="resume-sec">
          <h2 class="resume-h mono">Languages</h2>
          <div class="resume-body">
            <p>{languages.join(' · ')}</p>
          </div>
        </section>
      </article>

      <p class="cv-alt">Want to talk about a role or a project? <a href="/#contact">Get in touch</a> or <a href="/blog/">read my write-ups</a>.</p>
    </div>
  </section>

  <dialog class="qr-dialog" id="qr-dialog" aria-labelledby="qr-title">
    <p class="qr-title" id="qr-title">Scan to open my CV</p>
    <img src="/assets/img/cv-qr.svg" alt={`QR code that opens ${host}/cv`} width="264" height="264">
    <p class="qr-url mono">{host}/cv</p>
    <form method="dialog"><button class="btn" type="submit">Close</button></form>
  </dialog>

</Base>
