---
import Base from '../layouts/Base.astro';
---
<Base page="404" title="404 — Moaaz Afifi" noindex>
  <section class="hero hero-page">
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <div class="container">
      <p class="hero-kicker mono">Error 404</p>
      <h1 class="hero-name">Page not found</h1>
      <p class="hero-role">The page you're looking for doesn't exist or has been moved.</p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="/">Back to home</a>
        <a class="btn" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
