<section class="hero hero-page blog-hero">
  <div class="glow glow-a" aria-hidden="true"></div>
  <div class="glow glow-b" aria-hidden="true"></div>
  <div class="container blog-hero-grid">
    <div>
      <p class="hero-kicker mono">Engineering · Security · DevSecOps</p>
      <h1 class="hero-name">Engineering <span class="accent">&amp; Security</span></h1>
      <p class="hero-role">Building software and breaking it: product security, DevSecOps, and real-world vulnerabilities.</p>
      <ul class="blog-stats mono" aria-label="What I do">
        <li><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m10.5 10.5 3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><strong>Penetration testing</strong> · web, API &amp; mobile</li>
        <li><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1 2 3.5V8c0 3.2 2.5 6 6 7 3.5-1 6-3.8 6-7V3.5z"/></svg><strong>Product security</strong> &amp; DevSecOps</li>
        <li><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M5 4 1.5 8 5 12M11 4l3.5 4L11 12"/></svg><strong>Secure code review</strong></li>
      </ul>
    </div>

    <div class="scene" aria-hidden="true">
      <svg viewBox="0 0 560 470" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sc-ed" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1c222b"/>
            <stop offset="1" stop-color="#12161c"/>
          </linearGradient>
          <linearGradient id="sc-scan" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e5ac52" stop-opacity="0"/>
            <stop offset="0.5" stop-color="#e5ac52" stop-opacity="0.35"/>
            <stop offset="1" stop-color="#e5ac52" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="sc-sh" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a2214"/>
            <stop offset="1" stop-color="#17130c"/>
          </linearGradient>
          <clipPath id="sc-clip"><rect x="60" y="96" width="360" height="200" rx="4"/></clipPath>
        </defs>

        <!-- background network -->
        <g class="net">
          <line x1="20" y1="60" x2="120" y2="20" style="animation-delay:.05s"/>
          <line x1="120" y1="20" x2="260" y2="40" style="animation-delay:.15s"/>
          <line x1="260" y1="40" x2="420" y2="10" style="animation-delay:.25s"/>
          <line x1="420" y1="10" x2="540" y2="70" style="animation-delay:.35s"/>
          <line x1="540" y1="70" x2="520" y2="230" style="animation-delay:.45s"/>
          <line x1="520" y1="230" x2="545" y2="400" style="animation-delay:.55s"/>
          <line x1="20" y1="60" x2="10" y2="250" style="animation-delay:.2s"/>
          <line x1="10" y1="250" x2="30" y2="420" style="animation-delay:.4s"/>
          <circle cx="20" cy="60" r="4" style="animation-delay:.1s"/>
          <circle cx="120" cy="20" r="3" style="animation-delay:.2s"/>
          <circle class="hot" cx="260" cy="40" r="4" style="animation-delay:.3s"/>
          <circle cx="420" cy="10" r="3" style="animation-delay:.4s"/>
          <circle cx="540" cy="70" r="4" style="animation-delay:.5s"/>
          <circle class="hot" cx="520" cy="230" r="3" style="animation-delay:.6s"/>
          <circle cx="545" cy="400" r="4" style="animation-delay:.7s"/>
          <circle cx="10" cy="250" r="3" style="animation-delay:.45s"/>
          <circle cx="30" cy="420" r="4" style="animation-delay:.65s"/>
        </g>

        <!-- code editor -->
        <g class="editor">
          <rect x="40" y="56" width="400" height="260" rx="14" fill="url(#sc-ed)" stroke="#2f3743"/>
          <rect x="40" y="56" width="400" height="34" rx="14" fill="#232932"/>
          <rect x="40" y="76" width="400" height="14" fill="#232932"/>
          <circle cx="62" cy="73" r="5.5" fill="#ff5f57"/><circle cx="80" cy="73" r="5.5" fill="#febc2e"/><circle cx="98" cy="73" r="5.5" fill="#28c840"/>
          <text x="240" y="78" fill="#8b95a3" font-size="12" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace">auth/middleware.ts</text>
          <g fill="#3a4350" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">
            <text x="56" y="118">1</text><text x="56" y="142">2</text><text x="56" y="166">3</text><text x="56" y="190">4</text>
            <text x="56" y="214">5</text><text x="56" y="238">6</text><text x="56" y="262">7</text><text x="56" y="286">8</text>
          </g>
          <g class="code">
            <rect x="80" y="110" width="70" height="9" rx="4.5" fill="#d29bff" style="animation-delay:.9s"/>
            <rect x="158" y="110" width="120" height="9" rx="4.5" fill="#8bb4d4" style="animation-delay:1.05s"/>
            <rect x="96" y="134" width="90" height="9" rx="4.5" fill="#e5ac52" style="animation-delay:1.2s"/>
            <rect x="194" y="134" width="150" height="9" rx="4.5" fill="#4a5462" style="animation-delay:1.35s"/>
            <rect x="96" y="158" width="60" height="9" rx="4.5" fill="#d29bff" style="animation-delay:1.5s"/>
            <rect x="164" y="158" width="190" height="9" rx="4.5" fill="#8bb4d4" style="animation-delay:1.65s"/>
            <rect x="112" y="182" width="130" height="9" rx="4.5" fill="#4ade80" style="animation-delay:1.8s"/>
            <rect x="112" y="206" width="210" height="9" rx="4.5" fill="#4a5462" style="animation-delay:1.95s"/>
            <rect x="96" y="230" width="44" height="9" rx="4.5" fill="#d29bff" style="animation-delay:2.1s"/>
            <rect x="148" y="230" width="100" height="9" rx="4.5" fill="#e5ac52" style="animation-delay:2.25s"/>
            <rect x="80" y="254" width="20" height="9" rx="4.5" fill="#4a5462" style="animation-delay:2.4s"/>
            <rect x="80" y="278" width="160" height="9" rx="4.5" fill="#4a5462" style="animation-delay:2.55s"/>
          </g>
          <rect class="caret" x="246" y="276" width="7" height="13" fill="#e4e6eb"/>
          <g clip-path="url(#sc-clip)">
            <rect class="scanline" x="40" y="80" width="400" height="34" fill="url(#sc-scan)"/>
          </g>
        </g>

        <!-- shield -->
        <g class="shield">
          <circle class="shield-glow" cx="452" cy="104" r="46" fill="none" stroke="#e5ac52" stroke-width="2"/>
          <path class="shield-path" d="M452 52 L494 68 V104 C494 132 476 152 452 162 C428 152 410 132 410 104 V68 Z" fill="url(#sc-sh)" stroke="#e5ac52" stroke-width="3"/>
          <path class="check" d="M434 106 L447 119 L471 93" fill="none" stroke="#4ade80" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </g>

        <!-- delivery pipeline -->
        <g class="pipeline" font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="600">
          <path id="sc-track" class="pipe-track" d="M70 392 H 500" stroke="#3a4350" stroke-width="2" fill="none"/>
          <g class="stage"><rect x="34" y="372" width="92" height="40" rx="10" stroke-width="1.5"/><text x="80" y="397" fill="#b9c1cc" text-anchor="middle">build</text></g>
          <g class="stage"><rect x="152" y="372" width="92" height="40" rx="10" stroke-width="1.5"/><text x="198" y="397" fill="#b9c1cc" text-anchor="middle">test</text></g>
          <g class="stage"><rect x="270" y="372" width="92" height="40" rx="10" stroke-width="1.5"/><text x="316" y="397" fill="#b9c1cc" text-anchor="middle">scan</text></g>
          <g class="stage"><rect x="388" y="372" width="112" height="40" rx="10" stroke-width="1.5"/><text x="444" y="397" fill="#b9c1cc" text-anchor="middle">deploy</text></g>
          <circle r="6" fill="#e5ac52">
            <animateMotion dur="4s" repeatCount="indefinite" begin="1.6s" path="M70 392 H 500"/>
          </circle>
        </g>

        <!-- floating chips -->
        <g font-family="JetBrains Mono, ui-monospace, monospace" font-size="12">
          <g class="chip-in" style="animation-delay:2.6s"><g class="float-a">
            <rect x="2" y="300" width="112" height="30" rx="15" fill="#1b2029" stroke="#2f4a60"/>
            <text x="58" y="319" fill="#8bb4d4" text-anchor="middle">threat model</text>
          </g></g>
          <g class="chip-in" style="animation-delay:2.9s"><g class="float-b">
            <rect x="436" y="186" width="118" height="30" rx="15" fill="#10261a" stroke="#1f6b3d"/>
            <text x="495" y="205" fill="#4ade80" text-anchor="middle">0 critical ✓</text>
          </g></g>
          <g class="chip-in" style="animation-delay:3.2s"><g class="float-a">
            <rect x="300" y="18" width="96" height="30" rx="15" fill="#2a2214" stroke="#6b5530"/>
            <text x="348" y="37" fill="#e5ac52" text-anchor="middle">SAST · DAST</text>
          </g></g>
        </g>
      </svg>
    </div>
  </div>
</section>
