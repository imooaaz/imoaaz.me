---
/** Bottom tab bar, shown on phones only (CSS). */
import type { Page } from '../data/site';
interface Props { page: Page }
const { page } = Astro.props;
const base = page === 'home' ? '' : '/';
const tabs = [
  { href: `${base}#experience`, label: 'Experience', icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/>' },
  { href: `${base}#projects`, label: 'Projects', icon: '<path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M3 7l9 5 9-5M12 12v10"/>' },
  { href: '/cv/', label: 'CV', page: 'cv', icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11v6m0 0-3-3m3 3 3-3"/>' },
  { href: '/blog/', label: 'Blog', page: 'blog', icon: '<path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>' },
  { href: `${base}#contact`, label: 'Contact', icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
];
---
<nav class="tabbar" aria-label="Quick navigation">
  {tabs.map((t) => t.page === page
    ? <a href={t.href} class="active" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.label}</span></a>
    : <a href={t.href}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /><span>{t.label}</span></a>)}
</nav>
