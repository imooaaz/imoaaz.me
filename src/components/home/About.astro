---
import SectionTitle from '../SectionTitle.astro';
import { certsCount, certsShort } from '../../data/certs';
import { languages } from '../../data/services';
---
<section class="section" id="about">
  <div class="container">
    <div class="about-grid">
      <div>
        <SectionTitle eyebrow="About">A security engineer with a developer's background</SectionTitle>
        <div class="about-text">
          <p class="reveal">I came to security from software development. I read the code, not just the responses, so I understand what the developer intended and where that intent breaks.</p>
          <p class="reveal" style="--d:90ms">Today I work on both sides: shipping software at Raqyan, and attacking it as a penetration tester and bug bounty researcher. That mix lets me report findings developers can act on, with a fix that fits how the product is actually built.</p>
        </div>
      </div>

      <dl class="facts reveal" style="--d:140ms">
        <div class="fact">
          <dt class="mono">Focus</dt>
          <dd>Product security, application security, DevSecOps</dd>
        </div>
        <div class="fact">
          <dt class="mono">Current roles</dt>
          <dd>Cyber &amp; Product Security Engineer at Raqyan · Security consultant · HackerOne researcher</dd>
        </div>
        <div class="fact">
          <dt class="mono">Research</dt>
          <dd><a href="#projects" class="nowrap">CVE-2024-36436</a>, public and private bug bounty programs</dd>
        </div>
        <div class="fact">
          <dt class="mono">Certifications</dt>
          <dd><a href="#certs">{certsCount} certifications</a>: {certsShort}</dd>
        </div>
        <div class="fact">
          <dt class="mono">Languages</dt>
          <dd>{languages.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
