---
import SectionTitle from '../SectionTitle.astro';
---
<section class="logo-strip" aria-label="Brands I've worked with">
  <div class="container">
    <SectionTitle eyebrow="Client engagements">Brands I've worked with</SectionTitle>
  </div>
  <div class="marquee">
    <div class="marquee-track">
      <div class="marquee-set">
        <span class="logo-chip"><img src="/assets/img/logos/dib.png" alt="Dubai Islamic Bank" width="99" height="97"></span>
        <span class="logo-chip"><img src="/assets/img/logos/oracle.png" alt="Oracle" width="440" height="91"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-dark.png" alt="Amazon" width="214" height="120"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-green.png" alt="iHerb" width="110" height="110"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-purple.png" alt="StubHub" width="110" height="110"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-white.png" alt="" width="110" height="110"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-blue.png" alt="" width="106" height="110"></span>
        <span class="logo-chip"><img src="/assets/img/logos/mark-cream.png" alt="" width="110" height="110"></span>
      </div>
    </div>
  </div>
</section>
