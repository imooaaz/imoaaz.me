---
import SectionTitle from '../SectionTitle.astro';
---
<section class="section theme-dark" id="certs">
  <div class="container">
    <SectionTitle eyebrow="Certifications">Certifications</SectionTitle>

    <div class="cert-grid">
      <div class="cert reveal">
        <img class="cert-badge" src="/assets/img/certs/ecppt.svg" alt="" loading="lazy" width="150" height="150">
        <p class="cert-abbr">eCPPT</p>
        <p class="cert-name">Certified Professional Penetration Tester</p>
        <p class="cert-issuer mono">eLearnSecurity / INE</p>
      </div>
      <div class="cert reveal" style="--d:80ms">
        <img class="cert-badge" src="/assets/img/certs/ewptx.svg" alt="" loading="lazy" width="150" height="150">
        <p class="cert-abbr">eWPTX</p>
        <p class="cert-name">Web Penetration Tester eXtreme</p>
        <p class="cert-issuer mono">eLearnSecurity / INE</p>
      </div>
      <div class="cert reveal" style="--d:160ms">
        <img class="cert-badge" src="/assets/img/certs/emapt.svg" alt="" loading="lazy" width="150" height="150">
        <p class="cert-abbr">eMAPT</p>
        <p class="cert-name">Mobile Application Penetration Tester</p>
        <p class="cert-issuer mono">eLearnSecurity / INE</p>
      </div>
      <div class="cert reveal" style="--d:240ms">
        <img class="cert-badge" src="/assets/img/certs/eais.svg" alt="" loading="lazy" width="150" height="150">
        <p class="cert-abbr">eAIS</p>
        <p class="cert-name">AI Systems Security Specialist</p>
        <p class="cert-issuer mono">eLearnSecurity / INE</p>
      </div>
    </div>
  </div>
</section>
