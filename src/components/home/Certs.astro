---
import SectionTitle from '../SectionTitle.astro';
import { certs } from '../../data/certs';
---
<section class="section theme-dark" id="certs">
  <div class="container">
    <SectionTitle eyebrow="Credentials">{certs.length} professional certifications</SectionTitle>

    <ul class="cert-grid">
      {certs.map((c, i) => (
        <li class="cert reveal" style={i ? `--d:${(i % 3) * 80}ms` : undefined}>
          <img class:list={['cert-badge', { tile: c.tile }]} src={c.badge} alt="" loading="lazy" width="150" height="150">
          <div class="cert-txt">
            <h3 class="cert-abbr">{c.abbr}</h3>
            <p class="cert-name">{c.name}</p>
            <p class="cert-issuer mono">{c.issuer}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
