---
import SectionTitle from '../SectionTitle.astro';
import { services, domains } from '../../data/services';
---
<section class="section" id="services">
  <div class="container">
    <SectionTitle eyebrow="Services">What I can do for your team</SectionTitle>
    <p class="section-lede reveal">From the first design review to the final retest: security work that fits how your team already ships.</p>

    <ol class="work-list">
      {services.map((s, i) => (
        <li class="work-row reveal" style={i ? `--d:${i * 70}ms` : undefined}>
          <h3 class="work-name">{s.name}</h3>
          <div class="work-body">
            <p>{s.desc}</p>
            <p class="work-tags mono">{s.tags.join(' · ')}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="domains reveal">
      <p class="domains-head mono">Security domains I cover</p>
      <ul class="domains-list">
        {domains.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </div>
</section>
